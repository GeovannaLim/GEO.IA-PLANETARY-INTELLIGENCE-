# Copy to .env for local development. Never commit real credentials.
GEOIA_ENVIRONMENT=development
GEOIA_LOG_LEVEL=INFO
GEOIA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GEOIA_DB_PATH=var/geoia.sqlite3

# Network / limits (defaults shown)
GEOIA_HTTP_TIMEOUT_S=30
GEOIA_HTTP_RETRIES=3
GEOIA_HTTP_MAX_DOWNLOAD_BYTES=20971520
GEOIA_MAX_CONCURRENT_JOBS=3
GEOIA_JOB_TIMEOUT_S=240
GEOIA_RESULT_CACHE_TTL_S=86400
GEOIA_MAX_RADIUS_KM_MOON=25
GEOIA_MAX_RADIUS_KM_MARS=50
GEOIA_MAX_RADIUS_KM_EARTH=25
GEOIA_M3_MAX_HALF_WINDOW_PX=20
GEOIA_CRISM_MAX_HALF_WINDOW_PX=30

# Earth Engine — only POST /v1/earth/analyze uses it. Set ONE of:
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_JSON=
GEE_SERVICE_ACCOUNT_KEY_FILE=

# Real-network tests (pytest -m live)
GEOIA_LIVE_TESTS=0
