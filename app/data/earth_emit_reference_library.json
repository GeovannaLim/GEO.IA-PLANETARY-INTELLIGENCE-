{
 "name": "GEØ.IA terrestrial EMIT band-depth reference library",
 "version": "1.0.0",
 "derived_from": {
  "file": "earth_proxy_library_100.json",
  "sha256": "2a730716687af0ac73f17a19b0b952be61aca04c8d69870afa135cc1d3b91ba3"
 },
 "measurement": "NASA/EMIT/L2A/RFL (Earth Engine) median composite over a 10 km buffer around each site centroid; band depth per pixel then buffer mean; extracted by the legacy GEØ.IA pipeline (run_earth_pipeline.extract_gee_indices).",
 "definition": {
  "legacy_bd1000": "(C - R1000)/C, C = (R800 + R1300)/2, EMIT bands nearest to each wavelength, clamped >= 0",
  "legacy_bd2000": "(C - R2000)/C, C = (R1700 + R2300)/2, clamped >= 0"
 },
 "limitations": [
  "Extraction date and exact EMIT scene list were not archived by the legacy pipeline.",
  "Most entries are hydrothermal ore systems; many 2 µm depths are affected by alteration minerals and vegetation residue, not only by Fe2+ in mafic silicates.",
  "Site centroids were not stored with the vectors, so entries cannot be re-measured without the original site list."
 ],
